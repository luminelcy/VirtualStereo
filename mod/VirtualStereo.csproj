<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<RootNamespace>VirtualStereo</RootNamespace>
		<LangVersion>latest</LangVersion>
		<IsPackable>false</IsPackable>
		<AssemblyVersion>0.1.0.0</AssemblyVersion>
		<FileVersion>0.1.0.0</FileVersion>
		<NeutralLanguage>en-US</NeutralLanguage>
		<AssemblyName>VirtualStereo</AssemblyName>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<PropertyGroup>
		<EnableDefaultCompileItems>false</EnableDefaultCompileItems>
	</PropertyGroup>

	<!-- 壳：MelonLoader/Unity 侧 -->
	<ItemGroup>
		<Compile Include="Core.cs" />
		<Compile Include="AudioEngine.cs" />
		<Compile Include="DebugMenu.cs" />
		<Compile Include="VirtualStereoChannel.cs" />
	</ItemGroup>

	<!-- core：共享源码链接（保持单 dll 输出，符合 mod 发布打包惯例） -->
	<ItemGroup>
		<Compile Include="..\core\VsLog.cs" Link="core\VsLog.cs" />
		<Compile Include="..\core\AudioCapture\NativeAudio.cs" Link="core\AudioCapture\NativeAudio.cs" />
		<Compile Include="..\core\AudioCapture\SampleRing.cs" Link="core\AudioCapture\SampleRing.cs" />
		<Compile Include="..\core\AudioCapture\ProcessLoopbackCapture.cs" Link="core\AudioCapture\ProcessLoopbackCapture.cs" />
		<Compile Include="..\core\Phonon\PhononNative.cs" Link="core\Phonon\PhononNative.cs" />
		<Compile Include="..\core\Phonon\BinauralEngine.cs" Link="core\Phonon\BinauralEngine.cs" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="MelonLoader">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\MelonLoader.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Runtime">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.Runtime.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2CppInterop.Common">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\net6\Il2CppInterop.Common.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="Il2Cppmscorlib">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\Il2Cppmscorlib.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.CoreModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.AudioModule">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.AudioModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.InputLegacyModule">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.InputLegacyModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.IMGUIModule">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.IMGUIModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.PhysicsModule">
			<HintPath>..\..\gogh Focus with Your Avatar\MelonLoader\Il2CppAssemblies\UnityEngine.PhysicsModule.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<!-- Steam Audio 核心库（Apache 2.0）：随输出，部署时进游戏根目录 -->
	<ItemGroup>
		<None Include="..\phonon\phonon.dll" Link="phonon.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- 构建后自动部署到 Steam 游戏目录 -->
	<PropertyGroup>
		<GameModsDir>D:\SteamLibrary\steamapps\common\gogh Focus with Your Avatar\Mods</GameModsDir>
		<GameRootDir>D:\SteamLibrary\steamapps\common\gogh Focus with Your Avatar</GameRootDir>
	</PropertyGroup>
	<Target Name="DeployToGame" AfterTargets="Build" Condition="Exists('$(GameModsDir)')">
		<Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(GameModsDir)" />
		<Copy SourceFiles="..\phonon\phonon.dll" DestinationFolder="$(GameRootDir)" />
		<Message Importance="high" Text="Deployed $(AssemblyName).dll to $(GameModsDir)" />
	</Target>
</Project>
